# Example Environment Variables (Template)
# Copy to .env and configure for your environment

DATABASE_URL="postgresql://username:password@localhost:5432/restaurant_menu?schema=public"
PORT=3001
NODE_ENV=development
JWT_SECRET="your_secure_jwt_secret_key_here"

# -----------------------------------------------------------------------------
# CORS (Phase 14): Comma-separated allowlist of permitted browser origins.
# Local development defaults to the Vite dev server when ALLOWED_ORIGINS is unset.
# In production this MUST be set to the frontend origin(s), e.g.:
#   ALLOWED_ORIGINS="https://app.example.com"
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# -----------------------------------------------------------------------------
# Frontend API base URL (read at build time by Vite).
# Leave unset for same-origin deployments (frontend + API behind one origin via
# an Nginx reverse proxy that forwards /api). For a separate API origin, set the
# full base path including /api, e.g.:
#   VITE_API_URL="https://api.example.com/api"
# -----------------------------------------------------------------------------
VITE_API_URL=

# -----------------------------------------------------------------------------
# Media / Uploads (public URL handling)
# -----------------------------------------------------------------------------

# Backend public origin under which uploaded media (/uploads) is served.
# Leave empty in development (relative /uploads is proxied by Vite). In
# production, set it to the backend's public origin, e.g.:
#   PUBLIC_BASE_URL="https://visualmenu.outlethubs.com"
PUBLIC_BASE_URL=

# Frontend media base origin (optional override). When unset, the frontend
# derives the media origin from VITE_API_URL. Used only to resolve legacy
# relative /uploads/... URLs.
VITE_MEDIA_BASE_URL=

# -----------------------------------------------------------------------------
# Phase 8: Payment Gateways & Fiscal Settings
# -----------------------------------------------------------------------------

# Payment Providers (MOCK, STRIPE, MBWAY)
DEFAULT_PAYMENT_PROVIDER=MOCK
MOCK_PAYMENT_DEFAULT_OUTCOME=SUCCESS

# Stripe Card Processing (Hosted Elements / Tokenized)
# Note: Raw PAN / CVV is NEVER handled or stored on the server
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# Portuguese MB WAY Processing (SIBS / Gateway Partner)
MBWAY_ENTITY=12345
MBWAY_SUBENTITY=12345
MBWAY_API_KEY=mbway_test_api_key
MBWAY_SIMULATE_SUCCESS=true

# Fiscal Documents & Series
FISCAL_DEFAULT_SERIES=2026
FISCAL_AT_CERTIFIED_MODE=false

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MediaType {
  IMAGE
  VIDEO
}

enum QrTargetType {
  RESTAURANT_MENU
  TABLE_MENU
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum PlatformRole {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
  PLATFORM_VIEWER
}

enum ProvisioningStatus {
  PROVISIONING
  SUBSCRIPTION_PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum SubscriptionRequestStatus {
  PENDING
  PAYMENT_REQUIRED
  PAID
  APPROVED
  REJECTED
  CANCELLED
}

enum SubscriptionAssignmentType {
  PAID
  MANUAL
  COMPLIMENTARY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum NotificationType {
  SUBSCRIPTION_30_DAYS
  SUBSCRIPTION_14_DAYS
  SUBSCRIPTION_7_DAYS
  SUBSCRIPTION_3_DAYS
  SUBSCRIPTION_1_DAY
  SUBSCRIPTION_EXPIRED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_PAYMENT_FAILED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_SUSPENDED
  SUBSCRIPTION_RESTORED
  SYSTEM
  PLATFORM_MESSAGE
  SYSTEM_ALERT
  SECURITY_ALERT
  GENERAL_ANNOUNCEMENT
  SUBSCRIPTION_REQUESTED
  SUBSCRIPTION_PAYMENT_REQUIRED
  SUBSCRIPTION_PAYMENT_SUCCESS
}

enum NotificationSource {
  SYSTEM
  PLATFORM
  SECURITY
  SUBSCRIPTION
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PlatformMessageTargetType {
  RESTAURANT
  MULTIPLE_RESTAURANTS
  ALL_RESTAURANTS
}

enum PlatformMessageStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
  EXPIRED
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum StaffStatus {
  ACTIVE
  DISABLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ACTIVATE
  DEACTIVATE
  CONTEXT_ENTER
  CONTEXT_EXIT
  RESTAURANT_CREATE
  RESTAURANT_PROVISION_START
  RESTAURANT_PROVISION_SUCCESS
  RESTAURANT_PROVISION_FAILED
  OWNER_INVITATION_CREATE
  OWNER_INVITATION_RESEND
  OWNER_INVITATION_REVOKE
  OWNER_INVITATION_ACCEPT
  RESTAURANT_ACTIVATE
  RESTAURANT_DEACTIVATE
  STAFF_CREATE
  STAFF_UPDATE
  STAFF_DISABLE
  STAFF_ENABLE
  STAFF_REMOVE
  STAFF_INVITATION_CREATE
  STAFF_INVITATION_RESEND
  STAFF_INVITATION_REVOKE
  STAFF_INVITATION_ACCEPT
  STAFF_PERMISSION_GRANT
  STAFF_PERMISSION_REVOKE
  STAFF_ROLE_CHANGE
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_PLAN_CHANGED
  SUBSCRIPTION_PAYMENT_SUCCESS
  SUBSCRIPTION_PAYMENT_FAILED
  SUBSCRIPTION_GRACE_STARTED
  SUBSCRIPTION_EXPIRED
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_SUSPENDED
  SUBSCRIPTION_REACTIVATED
  SUBSCRIPTION_EXTENDED
  PLATFORM_MESSAGE_CREATED
  PLATFORM_MESSAGE_SCHEDULED
  PLATFORM_MESSAGE_SENT
  PLATFORM_MESSAGE_CANCELLED
  PLATFORM_MESSAGE_EXPIRED
  PLATFORM_MESSAGE_EDITED
  NOTIFICATION_READ
  NOTIFICATION_ACKNOWLEDGED
  SUBSCRIPTION_REQUESTED
  SUBSCRIPTION_PAYMENT_REQUIRED
  SUBSCRIPTION_MANUALLY_ASSIGNED
  SUBSCRIPTION_REVOKED
}

enum PaymentMethod {
  CASH
  CARD
  MBWAY
  MULTIBANCO
  OTHER
}

enum PaymentStatus {
  UNPAID
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentTransactionType {
  SALE
  AUTHORIZATION
  CAPTURE
  REFUND
  PARTIAL_REFUND
  VOID
  REVERSAL
}

enum FiscalDocumentType {
  RECEIPT
  INVOICE
  SIMPLIFIED_INVOICE
  CREDIT_NOTE
}

enum FiscalDocumentStatus {
  ISSUED
  CANCELLED
}

// -----------------------------------------------------------------------------
// CORE ENTITIES
// -----------------------------------------------------------------------------

model Restaurant {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique
  name            String
  tagline         String?
  description     String?  @db.Text
  logo            String?
  coverImage      String?  @map("cover_image")
  phone           String?
  email           String?
  address         String?
  city            String?
  country         String?
  legalName       String?  @map("legal_name")
  timezone        String?  @default("UTC")
  website         String?
  favicon         String?
  currency        String   @default("EUR")
  currencySymbol  String   @default("€") @map("currency_symbol")
  defaultLanguage String   @default("en") @map("default_language")
  active          Boolean  @default(true)
  provisioningStatus ProvisioningStatus @default(ACTIVE) @map("provisioning_status")
  createdByPlatformUserId String?        @map("created_by_platform_user_id") @db.Uuid
  provisionedAt      DateTime?          @map("provisioned_at")
  activatedAt        DateTime?          @map("activated_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relationships
  settings   RestaurantSettings?
  categories Category[]
  foods      FoodItem[]
  media      Media[]
  qrCodes    QrCode[]
  tables          Table[]
  orders          Order[]
  payments        Payment[]
  fiscalDocuments FiscalDocument[]
  customers       Customer[]
  userRestaurants UserRestaurant[]
  auditLogs       AuditLog[]
  ownerInvitations OwnerInvitation[]
  staffInvitations StaffInvitation[]
  subscriptions    Subscription[]
  subscriptionRequests SubscriptionRequest[]
  notifications    Notification[]
  messageRecipients PlatformMessageRecipient[]

  @@index([name])
  @@index([active])
  @@index([createdAt])
  @@index([provisioningStatus])
  @@map("restaurants")
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String
  slug         String
  description  String?  @db.Text
  icon         String?
  image        String?
  displayOrder Int      @default(0) @map("display_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  foods        FoodItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([active])
  @@index([displayOrder])
  @@map("categories")
}

model FoodItem {
  id              String    @id @default(uuid()) @db.Uuid
  restaurantId    String    @map("restaurant_id") @db.Uuid
  categoryId      String    @map("category_id") @db.Uuid
  name            String
  slug            String
  tagline         String?
  description     String?   @db.Text
  price           Decimal   @db.Decimal(10, 2)
  currency        String    @default("EUR")
  available       Boolean   @default(true)
  featured        Boolean   @default(false)
  spicyLevel      Int       @default(0) @map("spicy_level")
  preparationTime Int?      @map("preparation_time")
  displayOrder    Int       @default(0) @map("display_order")
  calories        Int?
  ingredients     String[]  @default([])
  allergens       String[]  @default([])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media        Media[]
  orderItems   OrderItem[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@index([categoryId])
  @@index([available])
  @@index([featured])
  @@index([displayOrder])
  @@index([deletedAt])
  @@index([restaurantId, available, deletedAt])
  @@index([restaurantId, categoryId, displayOrder])
  @@map("food_items")
}

model Media {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  foodItemId   String?   @map("food_item_id") @db.Uuid
  type         MediaType
  url          String    @db.Text
  thumbnailUrl String?   @map("thumbnail_url") @db.Text
  filename     String?
  mimeType     String?   @map("mime_type")
  size         Int?
  width        Int?
  height       Int?
  duration     String?
  altText      String?   @map("alt_text")
  isPrimary    Boolean   @default(false) @map("is_primary")
  desktopUrl   String?   @map("desktop_url") @db.Text
  mobileUrl    String?   @map("mobile_url") @db.Text
  posterUrl    String?   @map("poster_url") @db.Text
  sourceType   String    @default("EXTERNAL_URL") @map("source_type")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  foodItem   FoodItem?  @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([foodItemId])
  @@map("media")
}

model RestaurantSettings {
  id                   String   @id @default(uuid()) @db.Uuid
  restaurantId         String   @unique @map("restaurant_id") @db.Uuid
  primaryColor         String   @default("#eab308") @map("primary_color")
  secondaryColor       String   @default("#d97706") @map("secondary_color")
  accentColor          String   @default("#f59e0b") @map("accent_color")
  theme                String   @default("DARK_LUXURY")
  presentationMode     String   @default("INDIVIDUAL_VIDEO") @map("presentation_mode")
  textStyle            String   @default("SERIF") @map("text_style")
  buttonStyle          String   @default("PILL") @map("button_style")
  backgroundStyle      String   @default("DARK_BLUR") @map("background_style")
  cardStyle            String   @default("GLASSMORPHISM") @map("card_style")
  animationStyle       String   @default("CINEMATIC") @map("animation_style")
  categoryStyle        String   @default("PILLS") @map("category_style")
  foodInfoPosition     String   @default("BOTTOM_OVERLAY") @map("food_info_position")
  progressIndicatorStyle String @default("BAR") @map("progress_indicator_style")
  environmentBackground String  @default("DARK_STUDIO") @map("environment_background")
  tableSurface         String   @default("DARK_MARBLE") @map("table_surface")
  lightingPreset       String   @default("WARM") @map("lighting_preset")
  foodEntranceAnimation String  @default("SCALE") @map("food_entrance_animation")
  foodExitAnimation    String   @default("FADE") @map("food_exit_animation")
  cameraMotion         String   @default("SUBTLE_ZOOM") @map("camera_motion")
  overlayStyle         String   @default("GRADIENT_BOTTOM") @map("overlay_style")
  language             String   @default("en")
  secondaryLanguage    String?  @map("secondary_language")
  showPrices           Boolean  @default(true) @map("show_prices")
  showCalories         Boolean  @default(true) @map("show_calories")
  showPreparationTime  Boolean  @default(true) @map("show_preparation_time")
  showAllergens        Boolean  @default(true) @map("show_allergens")
  showIngredients      Boolean  @default(true) @map("show_ingredients")
  showFavoriteButton   Boolean  @default(true) @map("show_favorite_button")
  showDetailsButton    Boolean  @default(true) @map("show_details_button")
  showOrderButton      Boolean  @default(true) @map("show_order_button")
  taxEnabled           Boolean  @default(false) @map("tax_enabled")
  taxRate              Decimal  @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  serviceChargeEnabled Boolean  @default(false) @map("service_charge_enabled")
  serviceChargeRate    Decimal  @default(0.00) @map("service_charge_rate") @db.Decimal(5, 2)
  kdsWarningMinutes    Int      @default(15) @map("kds_warning_minutes")
  kdsUrgentMinutes     Int      @default(25) @map("kds_urgent_minutes")
  enabledPaymentMethods String[] @default(["CASH", "CARD", "MBWAY"]) @map("enabled_payment_methods")
  cashPaymentEnabled   Boolean  @default(true) @map("cash_payment_enabled")
  cardPaymentEnabled   Boolean  @default(true) @map("card_payment_enabled")
  mbwayPaymentEnabled  Boolean  @default(true) @map("mbway_payment_enabled")
  multibancoPaymentEnabled Boolean @default(false) @map("multibanco_payment_enabled")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_settings")
}

model QrCode {
  id           String       @id @default(uuid()) @db.Uuid
  restaurantId String       @map("restaurant_id") @db.Uuid
  tableId      String?      @map("table_id") @db.Uuid
  name         String
  slug         String       @unique
  targetType   QrTargetType @default(RESTAURANT_MENU) @map("target_type")
  targetValue  String       @map("target_value")
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      Table?     @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([tableId])
  @@index([slug])
  @@map("qr_codes")
}

// -----------------------------------------------------------------------------
// EXTENSIBLE FUTURE ENTITIES
// -----------------------------------------------------------------------------

model Table {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String?
  number       String   @map("number")
  capacity     Int      @default(4)
  location     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]
  qrCodes    QrCode[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@index([active])
  @@map("restaurant_tables")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  restaurantId   String      @map("restaurant_id") @db.Uuid
  tableId        String?     @map("table_id") @db.Uuid
  customerId     String?     @map("customer_id") @db.Uuid
  publicToken    String      @unique @default(uuid()) @map("public_token")
  idempotencyKey String?     @unique @map("idempotency_key")
  orderNumber    String      @map("order_number")
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(10, 2)
  tax            Decimal     @default(0.00) @db.Decimal(10, 2)
  discount       Decimal     @default(0.00) @db.Decimal(10, 2)
  serviceCharge  Decimal     @default(0.00) @map("service_charge") @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  currency       String      @default("EUR")
  customerNote   String?     @map("customer_note") @db.Text
  customerTaxId  String?     @map("customer_tax_id")
  customerTaxCountry String? @default("PT") @map("customer_tax_country")
  customerName   String?     @map("customer_name")
  customerEmail  String?     @map("customer_email")
  assignedWaiterUserRestaurantId String? @map("assigned_waiter_user_restaurant_id") @db.Uuid
  priority       String      @default("NORMAL")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  completedAt    DateTime?   @map("completed_at")
  cancelledAt    DateTime?   @map("cancelled_at")

  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table           Table?               @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer        Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedWaiter  UserRestaurant?      @relation("AssignedWaiterOrders", fields: [assignedWaiterUserRestaurantId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  fiscalDocuments FiscalDocument[]

  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
  @@index([publicToken])
  @@index([idempotencyKey])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, tableId])
  @@index([restaurantId, assignedWaiterUserRestaurantId])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @map("order_id") @db.Uuid
  foodItemId       String          @map("food_item_id") @db.Uuid
  foodNameSnapshot String          @map("food_name_snapshot")
  unitPrice        Decimal         @map("unit_price") @db.Decimal(10, 2)
  quantity         Int             @default(1)
  lineTotal        Decimal         @map("line_total") @db.Decimal(10, 2)
  customerNote     String?         @map("customer_note")
  status           OrderItemStatus @default(PENDING)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([foodItemId])
  @@map("order_items")
}

model OrderStatusHistory {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus  @map("to_status")
  changedByUserId String?      @map("changed_by_user_id") @db.Uuid
  metadata        Json?
  createdAt       DateTime     @default(now()) @map("created_at")

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_history")
}

model Customer {
  id                 String                  @id @default(uuid()) @db.Uuid
  restaurantId       String?                 @map("restaurant_id") @db.Uuid
  name               String?
  email              String?
  phone              String?
  preferredLanguage  String?                 @default("en") @map("preferred_language")
  marketingConsent   Boolean                 @default(false) @map("marketing_consent")
  marketingConsentAt DateTime?               @map("marketing_consent_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at")

  restaurant         Restaurant?             @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  fiscalProfiles     CustomerFiscalProfile[]
  orders             Order[]

  @@index([restaurantId])
  @@index([email])
  @@index([phone])
  @@map("customers")
}

model CustomerFiscalProfile {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  taxId          String   @map("tax_id")
  taxCountry     String   @default("PT") @map("tax_country")
  billingName    String?  @map("billing_name")
  billingAddress String?  @map("billing_address")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([taxId])
  @@map("customer_fiscal_profiles")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  restaurantId      String        @map("restaurant_id") @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  method            PaymentMethod
  provider          String
  providerPaymentId String?       @map("provider_payment_id")
  status            PaymentStatus @default(UNPAID)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("EUR")
  metadata          Json?
  receivedByUserId  String?       @map("received_by_user_id") @db.Uuid
  amountReceived    Decimal?      @map("amount_received") @db.Decimal(10, 2)
  changeGiven       Decimal?      @map("change_given") @db.Decimal(10, 2)
  completedAt       DateTime?     @map("completed_at")
  failedAt          DateTime?     @map("failed_at")
  cancelledAt       DateTime?     @map("cancelled_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  restaurant        Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receivedByUser    User?                @relation("StaffReceivedPayments", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  transactions      PaymentTransaction[]
  fiscalDocuments   FiscalDocument[]

  @@index([restaurantId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@index([providerPaymentId])
  @@index([restaurantId, status])
  @@map("payments")
}

model PaymentTransaction {
  id                    String                 @id @default(uuid()) @db.Uuid
  paymentId             String                 @map("payment_id") @db.Uuid
  type                  PaymentTransactionType
  providerTransactionId String?                @map("provider_transaction_id")
  amount                Decimal                @db.Decimal(10, 2)
  currency              String                 @default("EUR")
  status                String
  metadata              Json?
  createdAt             DateTime               @default(now()) @map("created_at")

  payment               Payment                @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([createdAt])
  @@map("payment_transactions")
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String    @map("provider_event_id")
  eventType       String    @map("event_type")
  payload         Json
  processed       Boolean   @default(false)
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@index([processed])
  @@map("payment_webhook_events")
}

model FiscalDocument {
  id                  String               @id @default(uuid()) @db.Uuid
  restaurantId        String               @map("restaurant_id") @db.Uuid
  orderId             String               @map("order_id") @db.Uuid
  paymentId           String?              @map("payment_id") @db.Uuid
  documentNumber      String               @map("document_number")
  series              String               @default("2026")
  sequenceNumber      Int                  @map("sequence_number")
  documentType        FiscalDocumentType   @default(RECEIPT) @map("document_type")
  status              FiscalDocumentStatus @default(ISSUED)
  currency            String               @default("EUR")
  subtotal            Decimal              @db.Decimal(10, 2)
  tax                 Decimal              @default(0.00) @db.Decimal(10, 2)
  serviceCharge       Decimal              @default(0.00) @map("service_charge") @db.Decimal(10, 2)
  discount            Decimal              @default(0.00) @db.Decimal(10, 2)
  total               Decimal              @db.Decimal(10, 2)
  customerName        String?              @map("customer_name")
  customerTaxId       String?              @map("customer_tax_id")
  customerTaxCountry  String?              @default("PT") @map("customer_tax_country")
  customerEmail       String?              @map("customer_email")
  customerAddress     String?              @map("customer_address")
  itemsSnapshot       Json?                @map("items_snapshot")
  metadata            Json?
  issuedAt            DateTime             @default(now()) @map("issued_at")
  cancelledAt         DateTime?            @map("cancelled_at")
  createdAt           DateTime             @default(now()) @map("created_at")

  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order               Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment             Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, series, sequenceNumber])
  @@index([restaurantId])
  @@index([orderId])
  @@index([paymentId])
  @@index([documentNumber])
  @@index([customerTaxId])
  @@map("fiscal_documents")
}

model User {
  id                     String               @id @default(uuid()) @db.Uuid
  email                  String               @unique
  passwordHash           String               @map("password_hash")
  name                   String
  active                 Boolean              @default(true)
  platformRole           PlatformRole?        @map("platform_role")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  userRestaurants        UserRestaurant[]
  auditLogs              AuditLog[]
  changedStatusHistories OrderStatusHistory[]
  paymentsAccepted       Payment[]            @relation("StaffReceivedPayments")
  createdInvitations     OwnerInvitation[]    @relation("CreatedOwnerInvitations")
  subscriptionEvents     SubscriptionEvent[]
  notifications          Notification[]
  createdNotifications   Notification[]       @relation("CreatedNotifications")
  acknowledgedNotifications Notification[]   @relation("AcknowledgedNotifications")
  sentPlatformMessages   PlatformMessage[]    @relation("SentPlatformMessages")
  editedMessageRevisions PlatformMessageRevision[] @relation("EditedMessageRevisions")
  createdStaffInvitations StaffInvitation[]   @relation("CreatedStaffInvitations")
  acknowledgedRecipients PlatformMessageRecipient[] @relation("RecipientAcknowledgedBy")
  requestedSubscriptions SubscriptionRequest[] @relation("RequestedSubscriptions")
  reviewedSubscriptionRequests SubscriptionRequest[] @relation("ReviewedSubscriptionRequests")
  assignedSubscriptions  Subscription[]       @relation("AssignedSubscriptions")

  @@index([platformRole])
  @@map("users")
}

model UserRestaurant {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  role         Role        @default(STAFF)
  jobTemplate  String?     @map("job_template")
  status       StaffStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  permissions  UserRestaurantPermission[]
  assignedOrders Order[]   @relation("AssignedWaiterOrders")

  @@unique([userId, restaurantId])
  @@index([userId])
  @@index([restaurantId])
  @@index([status])
  @@map("user_restaurants")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  group       String
  label       String
  description String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRestaurantPermissions UserRestaurantPermission[]

  @@index([group])
  @@index([active])
  @@map("permissions")
}

model UserRestaurantPermission {
  id               String         @id @default(uuid()) @db.Uuid
  userRestaurantId String         @map("user_restaurant_id") @db.Uuid
  permissionId     String         @map("permission_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  userRestaurant   UserRestaurant @relation(fields: [userRestaurantId], references: [id], onDelete: Cascade)
  permission       Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userRestaurantId, permissionId])
  @@index([userRestaurantId])
  @@index([permissionId])
  @@map("user_restaurant_permissions")
}

model StaffInvitation {
  id                String    @id @default(uuid()) @db.Uuid
  restaurantId      String    @map("restaurant_id") @db.Uuid
  userId            String?   @map("user_id") @db.Uuid
  invitedEmail      String    @map("invited_email")
  invitedName       String    @map("invited_name")
  phone             String?
  role              Role      @default(STAFF)
  jobTemplate       String?   @map("job_template")
  stagedPermissions String[]  @default([]) @map("staged_permissions")
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  acceptedAt        DateTime? @map("accepted_at")
  revokedAt         DateTime? @map("revoked_at")
  invitedByUserId   String?   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invitedByUser User?      @relation("CreatedStaffInvitations", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([invitedEmail])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("staff_invitations")
}

model OwnerInvitation {
  id              String    @id @default(uuid()) @db.Uuid
  restaurantId    String    @map("restaurant_id") @db.Uuid
  invitedEmail    String    @map("invited_email")
  invitedName     String    @map("invited_name")
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdByUser User?      @relation("CreatedOwnerInvitations", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([invitedEmail])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("owner_invitations")
}

model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String?     @map("restaurant_id") @db.Uuid
  userId       String?     @map("user_id") @db.Uuid
  action       AuditAction
  entityType        String        @map("entity_type")
  entityId          String        @map("entity_id")
  actorPlatformRole PlatformRole? @map("actor_platform_role")
  ipAddress         String?       @map("ip_address")
  metadata          Json?
  createdAt         DateTime      @default(now()) @map("created_at")

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([restaurantId, createdAt])
  @@map("audit_logs")
}

model Translation {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  field      String
  language   String   // e.g. "en", "pt", "fa", "fr"
  value      String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([entityType, entityId, field, language])
  @@index([entityType, entityId])
  @@index([language])
  @@map("translations")
}

model PlatformSettings {
  id                String   @id @default(uuid()) @db.Uuid
  platformName      String   @default("Aura SaaS") @map("platform_name")
  supportEmail      String   @default("support@auramenu.com") @map("support_email")
  defaultCurrency   String   @default("EUR") @map("default_currency")
  defaultLanguage   String   @default("en") @map("default_language")
  maintenanceMode   Boolean  @default(false) @map("maintenance_mode")
  allowRegistration Boolean  @default(true) @map("allow_registration")
  systemNotice      String?  @map("system_notice")
  featureFlags      Json?    @map("feature_flags")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// -----------------------------------------------------------------------------
// QR PRINT TEMPLATE SYSTEM
// Platform-owned print templates. Templates contain only the fixed
// background/design; restaurant data (logo, name, table, QR) is overlaid at
// print time and never stored inside a template.
// -----------------------------------------------------------------------------

enum QrPrintLayout {
  A4
  CARD
  A5
}

model QrPrintTemplate {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  description   String?       @db.Text
  backgroundUrl String?       @map("background_url")
  layout        QrPrintLayout @default(CARD)
  layoutConfig  Json?         @map("layout_config")
  active        Boolean       @default(true)
  createdById   String?       @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([active])
  @@map("qr_print_templates")
}

// -----------------------------------------------------------------------------
// SUBSCRIPTION BILLING DOMAIN (Phase 13A)
// Completely separate from restaurant order payment lifecycle.
// -----------------------------------------------------------------------------

model SubscriptionPlan {
  id               String          @id @default(uuid()) @db.Uuid
  code             String          @unique
  name             String
  description      String?         @db.Text
  price            Decimal         @db.Decimal(10, 2)
  currency         String          @default("EUR")
  billingInterval  BillingInterval @default(MONTHLY) @map("billing_interval")
  intervalCount    Int             @default(1) @map("interval_count")
  trialDays        Int?            @map("trial_days")
  gracePeriodDays  Int             @default(7) @map("grace_period_days")
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  subscriptions        Subscription[]
  subscriptionRequests SubscriptionRequest[]

  @@index([active])
  @@map("subscription_plans")
}

model Subscription {
  id                       String                     @id @default(uuid()) @db.Uuid
  restaurantId             String                     @unique @map("restaurant_id") @db.Uuid
  planId                   String                     @map("plan_id") @db.Uuid
  status                   SubscriptionStatus         @default(PENDING)
  startsAt                 DateTime                   @map("starts_at")
  currentPeriodStart       DateTime                   @map("current_period_start")
  currentPeriodEnd         DateTime                   @map("current_period_end")
  trialEndsAt              DateTime?                  @map("trial_ends_at")
  graceEndsAt              DateTime?                  @map("grace_ends_at")
  cancelledAt              DateTime?                  @map("cancelled_at")
  endedAt                  DateTime?                  @map("ended_at")
  autoRenew                Boolean                    @default(true) @map("auto_renew")
  provider                 String                     @default("MOCK")
  providerCustomerId       String?                    @map("provider_customer_id")
  providerSubscriptionId   String?                    @map("provider_subscription_id")
  agreedPrice              Decimal                    @db.Decimal(10, 2) @map("agreed_price")
  agreedCurrency           String                     @default("EUR") @map("agreed_currency")
  assignmentType           SubscriptionAssignmentType @default(PAID) @map("assignment_type")
  assignmentReason         String?                    @map("assignment_reason") @db.Text
  assignedByUserId         String?                    @map("assigned_by_user_id") @db.Uuid
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")

  restaurant               Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan                     SubscriptionPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  assignedByUser           User?                      @relation("AssignedSubscriptions", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  payments                 SubscriptionPayment[]
  invoices                 SubscriptionInvoice[]
  events                   SubscriptionEvent[]
  reminderLogs             SubscriptionReminderLog[]
  requests                 SubscriptionRequest[]

  @@index([restaurantId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([planId])
  @@index([providerSubscriptionId])
  @@index([assignmentType])
  @@index([restaurantId, status])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id                     String                    @id @default(uuid()) @db.Uuid
  subscriptionId         String                    @map("subscription_id") @db.Uuid
  amount                 Decimal                   @db.Decimal(10, 2)
  currency               String                    @default("EUR")
  status                 SubscriptionPaymentStatus @default(PENDING)
  provider               String
  providerTransactionId  String?                   @map("provider_transaction_id")
  idempotencyKey         String?                   @unique @map("idempotency_key")
  paidAt                 DateTime?                 @map("paid_at")
  failureReason          String?                   @map("failure_reason") @db.Text
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  subscription           Subscription              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@index([providerTransactionId])
  @@map("subscription_payments")
}

model SubscriptionInvoice {
  id                String             @id @default(uuid()) @db.Uuid
  subscriptionId    String             @map("subscription_id") @db.Uuid
  invoiceNumber     String             @unique @map("invoice_number")
  periodStart       DateTime           @map("period_start")
  periodEnd         DateTime           @map("period_end")
  subtotal          Decimal            @db.Decimal(10, 2)
  tax               Decimal            @default(0.00) @db.Decimal(10, 2)
  total             Decimal            @db.Decimal(10, 2)
  currency          String             @default("EUR")
  status            String             @default("DRAFT")
  issuedAt          DateTime?          @map("issued_at")
  paidAt            DateTime?          @map("paid_at")
  dueAt             DateTime?          @map("due_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  subscription      Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([invoiceNumber])
  @@map("subscription_invoices")
}

model SubscriptionEvent {
  id               String       @id @default(uuid()) @db.Uuid
  subscriptionId   String       @map("subscription_id") @db.Uuid
  eventType        String       @map("event_type")
  fromStatus       String?      @map("from_status")
  toStatus         String?      @map("to_status")
  actorId          String?      @map("actor_id") @db.Uuid
  reason           String?      @db.Text
  metadata         Json?
  createdAt        DateTime     @default(now()) @map("created_at")

  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  actor            User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([eventType])
  @@index([createdAt])
  @@map("subscription_events")
}

model Notification {
  id                   String               @id @default(uuid()) @db.Uuid
  restaurantId         String               @map("restaurant_id") @db.Uuid
  userId               String?              @map("user_id") @db.Uuid
  type                 NotificationType
  source               NotificationSource   @default(SYSTEM)
  priority             NotificationPriority @default(NORMAL)
  title                String
  message              String               @db.Text
  severity             NotificationSeverity @default(INFO)
  readAt               DateTime?            @map("read_at")
  acknowledgedAt       DateTime?            @map("acknowledged_at")
  acknowledgedByUserId String?              @map("acknowledged_by_user_id") @db.Uuid
  pinned               Boolean              @default(false)
  expiresAt            DateTime?            @map("expires_at")
  archivedAt           DateTime?            @map("archived_at")
  createdByUserId      String?              @map("created_by_user_id") @db.Uuid
  platformMessageId    String?              @map("platform_message_id") @db.Uuid
  metadata             Json?
  createdAt            DateTime             @default(now()) @map("created_at")

  restaurant           Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdByUser        User?                @relation("CreatedNotifications", fields: [createdByUserId], references: [id], onDelete: SetNull)
  acknowledgedByUser   User?                @relation("AcknowledgedNotifications", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  platformMessage      PlatformMessage?     @relation(fields: [platformMessageId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([userId])
  @@index([type])
  @@index([source])
  @@index([priority])
  @@index([readAt])
  @@index([platformMessageId])
  @@index([restaurantId, userId, readAt])
  @@map("notifications")
}

model PlatformMessage {
  id              String                    @id @default(uuid()) @db.Uuid
  senderUserId    String?                   @map("sender_user_id") @db.Uuid
  title           String
  message         String                    @db.Text
  priority        NotificationPriority      @default(NORMAL)
  targetType      PlatformMessageTargetType @map("target_type")
  status          PlatformMessageStatus     @default(SENT)
  scheduledAt     DateTime?                 @map("scheduled_at")
  expiresAt       DateTime?                 @map("expires_at")
  sentAt          DateTime?                 @map("sent_at")
  metadata        Json?
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  senderUser      User?                     @relation("SentPlatformMessages", fields: [senderUserId], references: [id], onDelete: SetNull)
  recipients      PlatformMessageRecipient[]
  revisions       PlatformMessageRevision[]
  notifications   Notification[]

  @@index([status])
  @@index([priority])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("platform_messages")
}

model PlatformMessageRecipient {
  id                   String           @id @default(uuid()) @db.Uuid
  messageId            String           @map("message_id") @db.Uuid
  restaurantId         String           @map("restaurant_id") @db.Uuid
  deliveredAt          DateTime?        @map("delivered_at")
  readAt               DateTime?        @map("read_at")
  acknowledgedAt       DateTime?        @map("acknowledged_at")
  acknowledgedByUserId String?          @map("acknowledged_by_user_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at")

  message              PlatformMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  restaurant           Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  acknowledgedByUser   User?            @relation("RecipientAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)

  @@unique([messageId, restaurantId])
  @@index([restaurantId])
  @@index([messageId])
  @@index([acknowledgedByUserId])
  @@map("platform_message_recipients")
}

model PlatformMessageRevision {
  id              String           @id @default(uuid()) @db.Uuid
  messageId       String           @map("message_id") @db.Uuid
  title           String
  content         String           @db.Text
  editedByUserId  String?          @map("edited_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")

  message         PlatformMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  editedByUser    User?            @relation("EditedMessageRevisions", fields: [editedByUserId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@map("platform_message_revisions")
}

model SubscriptionWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String    @map("provider_event_id")
  eventType       String    @map("event_type")
  payload         Json
  processed       Boolean   @default(false)
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@index([processed])
  @@map("subscription_webhook_events")
}

model SubscriptionReminderLog {
  id               String   @id @default(uuid()) @db.Uuid
  subscriptionId   String   @map("subscription_id") @db.Uuid
  eventType        String   @map("event_type")
  periodEnd        DateTime @map("period_end")
  sentAt           DateTime @default(now()) @map("sent_at")

  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventType, periodEnd])
  @@index([subscriptionId])
  @@map("subscription_reminder_logs")
}

model SubscriptionRequest {
  id                String                    @id @default(uuid()) @db.Uuid
  restaurantId      String                    @map("restaurant_id") @db.Uuid
  requestedPlanId   String                    @map("requested_plan_id") @db.Uuid
  requestedByUserId String                    @map("requested_by_user_id") @db.Uuid
  status            SubscriptionRequestStatus @default(PENDING)
  notes             String?                   @db.Text
  billingInterval   BillingInterval?          @map("billing_interval")
  reviewedByUserId  String?                   @map("reviewed_by_user_id") @db.Uuid
  subscriptionId    String?                   @map("subscription_id") @db.Uuid
  requestedAt       DateTime                  @default(now()) @map("requested_at")
  reviewedAt        DateTime?                 @map("reviewed_at")
  rejectionReason   String?                   @map("rejection_reason") @db.Text
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  restaurant        Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  requestedPlan     SubscriptionPlan          @relation(fields: [requestedPlanId], references: [id], onDelete: Restrict)
  requestedByUser   User                      @relation("RequestedSubscriptions", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedByUser    User?                     @relation("ReviewedSubscriptionRequests", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  subscription      Subscription?             @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([status])
  @@index([requestedAt])
  @@index([subscriptionId])
  @@map("subscription_requests")
}
